    <string name="rules_text">1. الكنستا الحمراء = 300\n
2. الكنستا السوداء = 200\n
3. إنهاء الجولة (الفتوح) = 100\n
4. الثلاثات الحمراء:\n
  - 1 = 100\n
  - 2 = 200\n
  - 3 = 300\n
  - 4 = 800\n
5. عند عدم وجود كنستا:\n
  - عقوبة ثابتة = -300\n
  - الثلاثات الحمراء تتحول إلى عقوبة (سالب)\n
  - لا تحتسب نقاط الأبواب ولا الحرق\n
6. مجموع الثلاثات الحمراء للفريقين يساوي دائماً 4\n
7. فريق واحد فقط يمكنه إنهاء الجولة\n
8. لا يسمح بإنهاء الجولة دون وجود كنستا\n\n
مثال 1 (مع كنستا):\n
نقاط الأبواب = 420\n
كنستا حمراء = 300\n
4 ثلاثات حمراء = 800\n
فتوح = 100\n
حرق = -75\n
النتيجة = 1545\n\n
مثال 2 (بدون كنستا):\n
ثلاثتان حمراوان = -200\n
عقوبة لا كنستا = -300\n
النتيجة = -500</string>
