<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.KanastaScore.SectionTitle"
        android:layout_marginStart="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_16"
        android:textColor="@color/primary"
        tools:text="اسم الفريق"/>

    <!-- Main Card containing all inputs -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/card_stroke_width"
        app:strokeColor="@color/outline"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20">

            <!-- Meld Points Section -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/direct_meld_total"
                android:layout_marginBottom="@dimen/spacing_4">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_direct_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_18"/>
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="@dimen/spacing_16">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_meld_plus_50"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_meld_plus_100"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_meld_plus_200"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+200"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_meld_clear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح"
                        android:textColor="@color/negativeScore"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Canastas Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_8">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/red_canastas_count"
                        app:boxStrokeColor="@color/canastaRed">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_red_canastas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/canastaRed"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_red_minus"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_minus"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_red_plus"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_plus"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/black_canastas_count"
                        app:boxStrokeColor="@color/canastaBlack">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_black_canastas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/canastaBlack"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_black_minus"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_minus"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_black_plus"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_plus"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_direct_mode_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/no_canasta_warning"
                android:textColor="@color/negativeScore"
                android:textSize="@dimen/text_12"
                android:visibility="gone"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_12"
                app:dividerColor="@color/divider"
                app:dividerThickness="1dp"/>

            <!-- Extra Info Section (Threes, Exit, Penalty) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/red_threes"
                        style="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/onSurface"/>
                    <TextView
                        android:id="@+id/tv_red_threes_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_10"
                        android:textColor="@color/onSurfaceVariant"
                        android:alpha="0.6"
                        tools:text="@string/red_threes_suggested"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_threes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_threes_0"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:padding="0dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_threes_1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:padding="0dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_threes_2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:padding="0dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_threes_3"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:padding="0dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_threes_4"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:padding="0dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Keep hidden but accessible if needed for logic -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <AutoCompleteTextView
                        android:id="@+id/actv_red_threes"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_red_threes_helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/red_threes_helper"
                android:textSize="@dimen/text_10"
                android:textColor="@color/onSurfaceVariant"
                android:alpha="0.5"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_exited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/exited_label"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/onSurface"/>

            <TextView
                android:id="@+id/tv_exited_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginBottom="@dimen/spacing_4"
                android:visibility="gone"
                tools:text="أنهى الفريق الأول الجولة"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/remaining_points"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_4">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_remaining_points"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/negativeScore"/>
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_burn_plus_25"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+25"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_burn_plus_50"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_burn_plus_100"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100"
                        android:layout_marginEnd="@dimen/spacing_4"
                        android:minWidth="60dp"
                        app:paddingStart="4dp"
                        app:paddingEnd="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_burn_clear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح"
                        android:textColor="@color/negativeScore"/>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_meld_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_gravity="end"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/primary"
        android:textStyle="bold"
        tools:text="مجموع نقاط الأبواب: 120"/>

</LinearLayout>
