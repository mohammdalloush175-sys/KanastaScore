<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_8"
        app:cardBackgroundColor="@color/primary"
        app:cardCornerRadius="@dimen/chip_corner_radius"
        app:cardElevation="@dimen/header_elevation"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_round_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/onPrimary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_18"
                    tools:text="الجولة 1"/>
                <TextView
                    android:id="@+id/tv_target_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/onPrimary"
                    android:alpha="0.8"
                    tools:text="الهدف: 5000"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/onPrimary"
                android:alpha="0.2"
                android:layout_marginVertical="@dimen/spacing_8"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_team1_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/onPrimary"
                    android:textSize="@dimen/text_14"
                    tools:text="الفريق 1: 1200 (حد: 90)"/>
                <TextView
                    android:id="@+id/tv_team2_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/onPrimary"
                    android:textSize="@dimen/text_14"
                    android:gravity="end"
                    tools:text="الفريق 2: 850 (حد: 50)"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_8">

            <!-- Team 1 Section -->
            <include
                android:id="@+id/section_team1"
                layout="@layout/layout_team_round_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/spacing_24"
                android:layout_marginHorizontal="@dimen/spacing_32"/>

            <!-- Team 2 Section -->
            <include
                android:id="@+id/section_team2"
                layout="@layout/layout_team_round_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_32"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12"
        android:background="@color/surface"
        android:elevation="@dimen/header_elevation"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_history"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/view_history"
            android:layout_marginEnd="@dimen/spacing_8"
            app:icon="@android:drawable/ic_menu_recent_history"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/preview_result"
            app:icon="@android:drawable/ic_menu_send"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
