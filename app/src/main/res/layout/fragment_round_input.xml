<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.KanastaScore.Title"
        app:layout_constraintTop_toTopOf="parent"
        tools:title="الجولة 1"/>

    <!-- Round Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summary_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12"
        android:layout_marginVertical="@dimen/spacing_8"
        app:cardBackgroundColor="@color/surfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_team1_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        tools:text="الفريق 1: 1200"/>
                    <TextView
                        android:id="@+id/tv_team1_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/onSurfaceVariant"
                        tools:text="حد التنزيل: 90"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="@dimen/spacing_8"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:id="@+id/tv_team2_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        tools:text="الفريق 2: 850"/>
                    <TextView
                        android:id="@+id/tv_team2_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/onSurfaceVariant"
                        tools:text="حد التنزيل: 50"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_target_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_4"
                android:textSize="@dimen/text_12"
                android:textColor="@color/onSurfaceVariant"
                tools:text="هدف المباراة: 5000"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/summary_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <!-- Team 1 Section -->
            <include
                android:id="@+id/section_team1"
                layout="@layout/layout_team_round_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="@dimen/spacing_24"
                android:layout_marginHorizontal="@dimen/spacing_24"/>

            <!-- Team 2 Section -->
            <include
                android:id="@+id/section_team2"
                layout="@layout/layout_team_round_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_32"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_16"
        android:background="@color/surface"
        android:elevation="@dimen/header_elevation"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_result"
            android:padding="@dimen/spacing_12"
            app:icon="@android:drawable/ic_menu_send"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
